{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules"
    ]
  },
  "hosting": {
    "public": "hosting",
    "redirects": [
      {
        "source": "/privacy",
        "destination": "https://anykind-apps.com/vault-anything-privacy/",
        "type": 301
      },
      {
        "source": "/delete-account",
        "destination": "https://anykind-apps.com/vault-anything-delete-account/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/.well-known/assetlinks.json",
        "destination": "/assetlinks.json"
      },
      {
        "source": "/join/**",
        "destination": "/index.html"
      },
      {
        "source": "/s/**",
        "function": {
          "functionId": "share",
          "region": "europe-west1"
        }
      }
    ]
  }
}
