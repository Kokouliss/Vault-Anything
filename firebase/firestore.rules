rules_version = '2';

// Who may read and write what. The document layout is described in
// core/data/src/main/kotlin/com/kokouliss/vaultanything/core/data/firebase/FirestoreSchema.kt.
// Change both together, and run `npm test` in this folder before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Email invitations only count for an address the sign-in provider has verified.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isInvited(space) {
      return request.auth.token.email_verified == true && myEmail() in space.invitedEmails;
    }

    function space(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }

    function isSpaceMember(spaceId) {
      return signedIn() && uid() in space(spaceId).memberIds;
    }

    // A missing role counts as child, like in the app.
    function roleOf(space, memberId) {
      return space.members.get(memberId, {}).get('role', 'child');
    }

    function isAdult(space) {
      return roleOf(space, uid()) == 'adult';
    }

    // True when, after this write, the invite document for `code` points at this space.
    function inviteWillPointHere(spaceId, code) {
      return getAfter(/databases/$(database)/documents/invites/$(code)).data.spaceId == spaceId;
    }

    function validSpace(space) {
      return space.keys().hasOnly(['name', 'ownerId', 'memberIds', 'members', 'inviteCode', 'invitedEmails', 'createdAt'])
        && space.name is string && space.name.size() > 0 && space.name.size() <= 60
        && space.ownerId is string
        && space.memberIds is list
        && space.members is map
        // Same alphabet as InviteCode in the app: no 0, 1, I or O.
        && space.inviteCode is string && space.inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && space.invitedEmails is list
        // The owner is always an adult.
        && roleOf(space, space.ownerId) == 'adult';
    }

    // One member's entry: the name the family sees and whether they are an adult or a child.
    function validMember(entry) {
      return entry.keys().hasOnly(['name', 'role', 'inviteCode'])
        && entry.name is string && entry.name.size() > 0 && entry.name.size() <= 100
        && entry.role in ['adult', 'child'];
    }

    function validDocument(document) {
      return document.keys().hasOnly(['ownerId', 'title', 'kind', 'category', 'tags', 'favorite', 'expiresDay', 'note',
          'link', 'fileName', 'mimeType', 'sizeBytes', 'uploaded', 'thumbnail', 'text', 'addedById', 'addedByName', 'createdAt', 'updatedAt'])
        && document.ownerId is string
        && document.title is string && document.title.size() > 0 && document.title.size() <= 100
        && document.kind in ['file', 'image', 'link']
        && document.category in ['identity', 'health', 'home', 'car', 'school', 'finance', 'other']
        && document.tags is list && document.tags.size() <= 10
        && document.favorite is bool
        // Days since 1 January 1970, or nothing.
        && (document.get('expiresDay', null) == null || document.expiresDay is int)
        && (document.get('note', null) == null || (document.note is string && document.note.size() <= 1000))
        && (document.kind == 'link'
          // Web addresses only: other members open the link with a tap.
          ? (document.link is string && document.link.size() <= 2000 && document.link.matches('^https?://.+$')
            && !document.keys().hasAny(['fileName', 'mimeType', 'sizeBytes', 'uploaded']))
          // Files live in Cloud Storage; MAX_FILE_BYTES in the app and storage.rules say 25 MB too.
          : (document.fileName is string && document.fileName.size() <= 255
            && document.mimeType is string && document.mimeType.size() <= 100
            && document.sizeBytes is int && document.sizeBytes >= 0 && document.sizeBytes <= 26214400
            && document.uploaded is bool
            && !('link' in document)))
        && (!('thumbnail' in document) || (document.thumbnail is bytes && document.thumbnail.size() <= 60000))
        // The words read off a scan, for search. MAX_TEXT_LENGTH in the app.
        && (!('text' in document) || (document.text is string && document.text.size() <= 10000))
        && document.addedById is string
        && document.addedByName is string && document.addedByName.size() <= 100
        && document.createdAt is timestamp
        && document.updatedAt is timestamp;
    }

    match /spaces/{spaceId} {
      // Members see their spaces. Invited people see the space so they can accept or decline.
      allow read: if signedIn() && (uid() in resource.data.memberIds || isInvited(resource.data));

      // A new space has exactly one member, its owner, an adult, and comes with its invite document.
      allow create: if signedIn()
        && validSpace(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && validMember(request.resource.data.members[uid()])
        && request.resource.data.invitedEmails.size() == 0
        && inviteWillPointHere(spaceId, request.resource.data.inviteCode);

      allow update: if signedIn()
        && validSpace(request.resource.data)
        && (ownerEdits() || memberEditsEmailInvites() || joinsWithCode() || acceptsEmailInvite()
            || declinesEmailInvite() || leaves() || handsOver() || renamesSelf() || setsRole());

      allow delete: if signedIn() && resource.data.ownerId == uid();

      function changedFields() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function membersDiff() {
        return request.resource.data.members.diff(resource.data.members);
      }

      function changedMembers() {
        return membersDiff().affectedKeys();
      }

      function newEntry(memberId) {
        return request.resource.data.members[memberId];
      }

      function changedEntryFields(memberId) {
        return newEntry(memberId).diff(resource.data.members[memberId]).affectedKeys();
      }

      // The owner may rename the space, remove members, manage email invites and replace the
      // invite code, but never hand the space to someone else or lock themselves out.
      function ownerEdits() {
        return resource.data.ownerId == uid()
          && changedFields().hasOnly(['name', 'inviteCode', 'memberIds', 'members', 'invitedEmails'])
          && uid() in request.resource.data.memberIds
          && request.resource.data.members.keys().hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.hasAll(request.resource.data.members.keys())
          // Removing is the only change to the members: whoever stays keeps their entry.
          && membersDiff().addedKeys().size() == 0
          && membersDiff().changedKeys().size() == 0
          && (request.resource.data.inviteCode == resource.data.inviteCode
              || inviteWillPointHere(spaceId, request.resource.data.inviteCode));
      }

      function memberEditsEmailInvites() {
        return uid() in resource.data.memberIds && changedFields().hasOnly(['invitedEmails']);
      }

      // The only change is that the caller appears as a new member, and a child until an adult says otherwise.
      function addsOnlySelf() {
        return !(uid() in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && uid() in request.resource.data.memberIds
          && changedMembers().hasOnly([uid()])
          && validMember(newEntry(uid()))
          && newEntry(uid()).role == 'child';
      }

      // Someone who cannot read the space proves they know its code by writing it into their own
      // member entry. A wrong guess is simply rejected.
      function joinsWithCode() {
        return changedFields().hasOnly(['memberIds', 'members'])
          && addsOnlySelf()
          && newEntry(uid()).inviteCode == resource.data.inviteCode;
      }

      function removesOnlyOwnEmailInvite() {
        return request.resource.data.invitedEmails.toSet()
          == resource.data.invitedEmails.toSet().difference([myEmail()].toSet());
      }

      function acceptsEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['memberIds', 'members', 'invitedEmails'])
          && addsOnlySelf()
          && removesOnlyOwnEmailInvite();
      }

      function declinesEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['invitedEmails'])
          && removesOnlyOwnEmailInvite();
      }

      // The caller disappears from memberIds and members.
      function removesSelf() {
        return uid() in resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && !(uid() in request.resource.data.memberIds)
          && !(uid() in request.resource.data.members);
      }

      // A member removes themselves and nothing else. The owner hands over or deletes the space instead.
      function leaves() {
        return uid() != resource.data.ownerId
          && changedFields().hasOnly(['memberIds', 'members'])
          && removesSelf()
          && changedMembers().hasOnly([uid()]);
      }

      // A member changes the name in their own entry, and nothing else.
      function renamesSelf() {
        return uid() in resource.data.memberIds
          && changedFields().hasOnly(['members'])
          && changedMembers().hasOnly([uid()])
          && changedEntryFields(uid()).hasOnly(['name'])
          && validMember(newEntry(uid()));
      }

      // The owner leaves and makes another member the owner, so the space goes on without them. The
      // new owner is made an adult in the same write, because the owner is always one.
      function handsOver() {
        return uid() == resource.data.ownerId
          && changedFields().hasOnly(['ownerId', 'memberIds', 'members'])
          && request.resource.data.ownerId in resource.data.memberIds
          && request.resource.data.ownerId != uid()
          && removesSelf()
          && changedMembers().hasOnly([uid(), request.resource.data.ownerId])
          && changedEntryFields(request.resource.data.ownerId).hasOnly(['role'])
          && validMember(newEntry(request.resource.data.ownerId));
      }

      // An adult makes another member an adult or a child. Not themselves, and not the owner, who
      // is always an adult. The member entry that changed cannot be named in a rule, so neither its
      // name nor its new role value is checked here: an adult could rename that member in the same
      // write, or store a made-up role, which the app never does and which gives away nothing,
      // because every role other than 'adult' counts as child (roleOf above and Role in the app).
      function setsRole() {
        return isAdult(resource.data)
          && changedFields().hasOnly(['members'])
          && changedMembers().size() == 1
          && !(uid() in changedMembers())
          && !(resource.data.ownerId in changedMembers())
          && membersDiff().addedKeys().size() == 0
          && membersDiff().removedKeys().size() == 0;
      }

      // The documents of the family. Children see their own; adults see everyone's and manage the children's.
      match /documents/{documentId} {
        function theSpace() {
          return space(spaceId);
        }

        function maySee(ownerId) {
          return ownerId == uid() || isAdult(theSpace());
        }

        // Their own, or a child's seen by an adult. Adults see each other's documents but do not touch them.
        function mayManage(ownerId) {
          return ownerId == uid() || (isAdult(theSpace()) && roleOf(theSpace(), ownerId) != 'adult');
        }

        // A child's query asks for their own documents only; the rules refuse a wider one.
        allow read: if isSpaceMember(spaceId) && maySee(resource.data.ownerId);

        allow create: if isSpaceMember(spaceId)
          && validDocument(request.resource.data)
          && request.resource.data.ownerId in theSpace().memberIds
          && mayManage(request.resource.data.ownerId)
          && request.resource.data.addedById == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Whose it is, what it is and who added it never change.
        allow update: if isSpaceMember(spaceId)
          && validDocument(request.resource.data)
          && mayManage(resource.data.ownerId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'kind', 'link', 'fileName', 'mimeType', 'sizeBytes', 'thumbnail', 'addedById', 'addedByName', 'createdAt']);

        allow delete: if isSpaceMember(spaceId) && mayManage(resource.data.ownerId);
      }
    }

    // The devices that get a person's notifications. Only that person's own devices write here;
    // firebase/functions reads it with admin rights.
    match /users/{userId}/tokens/{token} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['updatedAt']);
    }

    // invites/{code} maps an invite code to its space.
    match /invites/{code} {
      // Fetched by exact code only, so codes cannot be listed.
      allow get: if signedIn();
      allow list: if false;

      // Only together with a space, owned by the caller, that uses exactly this code.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['spaceId'])
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.ownerId == uid()
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.inviteCode == code;

      allow update: if false;

      allow delete: if signedIn()
        && get(/databases/$(database)/documents/spaces/$(resource.data.spaceId)).data.ownerId == uid();
    }
  }
}
